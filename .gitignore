# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual Environment ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Data — never commit large training datasets ───────────────────────────────
data/

# ── PowerPoint files ──────────────────────────────────────────────────────────
*.pptx
*.ppt

# ── Presentation Assets ───────────────────────────────────────────────────────
Presentation Assets/

# ── Model Checkpoints ─────────────────────────────────────────────────────────
checkpoints/*
!checkpoints/best.pth
checkpoints_v4/
checkpoints_v5/*
!checkpoints_v5/best.pth
*.pt
*.ckpt

# ── Training Logs & TensorBoard ───────────────────────────────────────────────
runs/
logs/

# ── Results (keep samples, not bulk output) ───────────────────────────────────
results/*
!results/samples/
!results/training_summary.json
!results/training_metrics.jsonresults_v5/*
!results_v5/training_summary.json
!results_v5/training_metrics.json
# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
